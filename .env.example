# ==========================================
# Authentication & JWT Configuration
# ==========================================

# Secret key used to sign and verify Access JWTs (minimum 32 characters)
JWT_SECRET=miracle-super-secure-jwt-secret-key-at-least-32-characters-2026

# Secret key used to sign and verify Refresh JWTs (optional, defaults to JWT_SECRET-refresh)
JWT_REFRESH_SECRET=miracle-super-secure-jwt-refresh-secret-key-32-chars-2026

# NextAuth / Auth.js fallback secret
AUTH_SECRET=miracle-super-secure-jwt-secret-key-at-least-32-characters-2026

# ==========================================
# Google OAuth 2.0 Credentials
# Get these from Google Cloud Console -> APIs & Services -> Credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret


# ==========================================
# Application URLs
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# Database Connection (Neon / PostgreSQL)
# ==========================================
DATABASE_URL=postgres://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
